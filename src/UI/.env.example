# TicketRadar Frontend Environment Variables Template
# Copy this file to '.env' and fill in your values.

# Firebase Web Configuration (Required for Google Auth and App Check)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_app_id

# Application Environment ('development' or 'production')
# If set to 'production', App Check with reCAPTCHA v3 is enforced unless VITE_DISABLE_SECURITY=true
VITE_ENVIRONMENT=development

# Security Settings (Set to true to disable reCAPTCHA and App Check for Self-Hosted / On-Premise / Running from Source Code)
VITE_DISABLE_SECURITY=false

# Payment & Wallet Settings (Set to true to disable payment gateway and wallet features for Self-Hosted / Free Mode)
VITE_DISABLE_PAYMENTS=false

# reCAPTCHA & App Check site keys
VITE_APP_CHECK_SITE_KEY=your_recaptcha_v3_site_key
VITE_RECAPTCHA_V2_SITE_KEY=your_recaptcha_v2_site_key
# Dev-only: set to `true` to use Firebase's auto-generated debug token locally.
# In production this is ignored; App Check uses the reCAPTCHA v3 site key above.
VITE_APP_CHECK_DEBUG_TOKEN=true

# Backend Server URL (http://127.0.0.1:8000 for local dev, https://api.ticketradar.darkglance.in for production)
VITE_BACKEND_URL=https://api.ticketradar.darkglance.in

